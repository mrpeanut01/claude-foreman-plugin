{
  "auto_merge": false,
  "caps": {
    "pushes": 8,
    "review_rounds": 5,
    "reruns": 2
  },
  "limits": {
    "max_open_prs": 3,
    "max_batch_issues": 5,
    "max_batch_weight": 6,
    "max_ci_minutes_per_day": 400,
    "stale_after_s": 5400,
    "triage_every_s": 3600
  },
  "benchmark_jobs": ["bench", "*simulation*", "load-test"],
  "benchmark_paths": {
    "bench": ["src/**", "!src/**/*.md"]
  },
  "risk_ceiling": "medium",
  "protected_paths": [
    "**/auth/**",
    "**/migrations/**",
    "**/payments/**",
    ".github/workflows/**"
  ],
  "merge_method": "squash"
}
