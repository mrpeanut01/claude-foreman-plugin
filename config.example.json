{
  "auto_merge": false,
  "caps": {
    "pushes": 3,
    "review_rounds": 5,
    "reruns": 2
  },
  "limits": {
    "max_open_prs": 3,
    "max_batch_issues": 5,
    "max_batch_weight": 6,
    "max_ci_minutes_per_day": 400
  },
  "risk_ceiling": "medium",
  "protected_paths": [
    "**/auth/**",
    "**/migrations/**",
    "**/payments/**",
    ".github/workflows/**"
  ],
  "merge_method": "squash"
}
